# Copy to .env and adjust for your deployment. These are read from real
# process environment variables - if you're not using Docker/a platform that
# auto-loads .env, export these yourself (e.g. in your systemd unit file).

# "development" or "production". Controls CORS defaults and hides /docs & /redoc in production.
ENVIRONMENT=production

# Comma-separated list of allowed origins for CORS. Leave unset/empty for a
# same-origin deployment (the default: FastAPI serves the frontend directly).
ALLOWED_ORIGINS=

# Set to "true" to force-enable interactive API docs even in production.
ENABLE_DOCS=false

# REQUIRED in production: secret used to sign login tokens (JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset in development, an ephemeral one is generated (logins reset on restart).
JWT_SECRET=

# How long a login stays valid, in minutes. Default: 7 days.
JWT_EXPIRE_MINUTES=10080

# Where the SQLite user accounts database file is stored.
USERS_DB_PATH=app/data/users.db
